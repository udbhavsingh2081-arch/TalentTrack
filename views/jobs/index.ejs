<% layout("/layouts/boilerplate") %>

<div class="container mt-4 job-index">

    <h2 class="mb-4">Available Jobs</h2>

    <div class="row g-4">

        <% for(let job of alljobs){ %>

        <div class="col-lg-4 col-md-6">

            <div class="card h-100 shadow-sm job-card">

                <div class="card-body d-flex flex-column">

                    <% if(job.companyLogo && job.companyLogo.url){ %>

                    <div class="logo-container">

                        <img
                            src="<%= job.companyLogo.url %>"
                            class="company-logo"
                            alt="<%= job.company %>"
                        >

                    </div>

                    <% } else { %>

                    <div class="logo-container">

                        <i
                            class="fa-solid fa-building company-placeholder"
                        ></i>

                    </div>

                    <% } %>

                    <h5 class="card-title text-center">
                        <%= job.title %>
                    </h5>

                    <h6 class="text-muted text-center mb-3">
                        <%= job.company %>
                    </h6>
                        <div class="text-center mb-3">
    <span class="badge bg-success">
        Actively Hiring
    </span>
</div>
              <p class="card-text flex-grow-1">
    <%= job.description
        ? (job.description.length > 120
            ? job.description.substring(0, 120) + "..."
            : job.description)
        : "No description available." %>
</p>

<p class="mb-1">
    <strong>Salary:</strong>
    <%= job.salary != null
        ? "₹" + Number(job.salary).toLocaleString("en-IN")+"/month"
        : "Not specified" %>
</p>

                    <p class="mb-3">
                        <strong>Location:</strong>
                        <%= job.location %>
                    </p>

          <a
    href="/talenttrack/jobs/<%= job._id %>"
    class="btn btn-primary mt-auto w-100 mb-2"
>
    View Details
</a>

<% if (currUser && currUser.role === "student") { %>
    <form
        action="/talenttrack/jobs/<%= job._id %>/save"
        method="POST"
    >
        <button
            type="submit"
            class="btn btn-outline-primary w-100"
        >
            <i class="fa-regular fa-bookmark"></i>
            Save Job
        </button>
    </form>
<% } %>

                </div>

            </div>

        </div>

        <% } %>

    </div>

</div>