<% layout("/layouts/boilerplate") %>

<div class="container mt-4 job-details">

    <div class="card shadow-sm mb-4">
        <div class="card-body ">
            <div class="d-flex justify-content-between align-items-start ">
<div class="card-img ">

    <% if(job.companyLogo && job.companyLogo.url){ %>

        <img
            src="<%= job.companyLogo.url %>"
            alt="Company Logo"
            width="80"
            height="80"
            class="rounded mb-3 border"
            style="object-fit:cover;"
        >

    <% } %>

    <h1 class="fw-bold">
        <%= job.title %>
    </h1>

    <h5 class="text-muted">
        <i class="fa-solid fa-building"></i>
        <%= job.company %>
    </h5>

    <span class="badge recruiting-badge">
        Actively Hiring
    </span>

    <p class="mt-3">
        <i class="fa-solid fa-location-dot"></i>
        <%= job.location %>
    </p>

    <p class="text-success fw-bold">
        <i class="fa-solid fa-indian-rupee-sign"></i>
        <%= job.salary.toLocaleString() %>
    </p>

</div>

                <div class="job-button">
                  <% if(currUser && currUser.role === "student"){ %>

    <% if(alreadyApplied){ %>

        <button
            class="btn btn-secondary"
            disabled
        >
            Applied ✓
        </button>

    <% } else { %>

        <form
            action="/talenttrack/jobs/<%= job._id %>/apply"
            method="POST"
        >
            <button class="btn btn-success">
                Apply Now
            </button>
        </form>

    <% } %>

<% } %>

<% if(isOwner){ %>

     <form method="post" action="/talenttrack/jobs/<%=job._id%>?_method=DELETE"> 

        <button class=" btn btn-outline-primary">Delete</button>
     </form>
       <a class="btn btn-outline-primary" href="/talenttrack/jobs/edit/<%=job._id%>">Edit</a> 
                  

<% } %>
   

                </div>
                    
            </div>

        </div>
    </div>



    <div class="row">

        <!-- Left Section -->

        <div class="col-md-8  ">

            <div class="card shadow-sm mb-4  job-detail-left ">
                <div class="card-body">

                   <div>  <h3>About the Role</h3></div>
                    <hr>

                    <p>
                        <%= job.description %>
                    </p>

                </div>
            </div>

        </div>



        <!-- Right Section -->

        <div class="col-md-4 ">

            <div class="card shadow-sm job-detail-left">
                <div class="card-body ">

                    <h4 >Job Overview</h4>
                    <% if(job.companyLogo && job.companyLogo.url){ %>

    <div class="text-center mb-3">

        <img
            src="<%= job.companyLogo.url %>"
            alt="Company Logo"
            width="100"
            height="100"
            class="rounded border"
            style="object-fit:cover;"
        >

    </div>

<% } %>
                    <hr>

                    <p>
                        <strong>Company:</strong><br>
                        <%= job.company %>
                    </p>

                    <p>
                        <strong>Location:</strong><br>
                        <%= job.location %>
                    </p>

                    <p>
                        <strong>Salary:</strong><br>
                        ₹<%= job.salary.toLocaleString() %>
                    </p>
                  <% if(job.recruiter){ %>

<a href="/talenttrack/recruiter/<%= job.recruiter._id %>" class=" job-recruiter">
    View Recruiter
</a>

<% } %>
               </div>
            </div>

        </div>

    </div>



    <div class="mt-4">

        <a href="/talenttrack/jobs" class="btn btn-secondary">
            Back to Jobs
        </a>

    </div>

</div>