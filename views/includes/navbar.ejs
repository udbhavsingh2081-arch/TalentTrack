
<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top">
    <div class="container-fluid">

        <a class="navbar-brand" href="/talenttrack/jobs">
            Talent Track
        </a>

        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarSupportedContent"
            aria-controls="navbarSupportedContent"
            aria-expanded="false"
            aria-label="Toggle navigation"
        >
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarSupportedContent">

            <!-- Left section: Navigation links -->
            <div class="navbar-nav nav-icon align-items-lg-center">

                <a class="nav-link" href="/talenttrack/jobs">
                    Browse Jobs
                </a>

                <% if (currUser && currUser.role === "recruiter") { %>
                    <a class="nav-link" href="/talenttrack/recruiter/dashboard">
                        Dashboard
                    </a>
                <% } %>

                <% if (currUser && currUser.role === "student") { %>
                    <a class="nav-link" href="/talenttrack/student/dashboard">
                        Dashboard
                    </a>

                    <a class="nav-link saved-jobs-link" href="/talenttrack/saved-jobs">
    <i class="fa-regular fa-bookmark"></i>
    <span>Saved Jobs</span>
</a>
                <% } %>

            </div>

            <!-- Middle section: Search -->
            <form
                class="d-flex search-form mx-lg-3 my-2 my-lg-0"
                action="/talenttrack/jobs"
                method="GET"
                role="search"
            >
                <input
                    class="form-control me-2"
                    type="search"
                    name="search"
                    placeholder="Search jobs"
                    aria-label="Search jobs"
                >

                <button class="btn btn-outline-success" type="submit">
                    Search
                </button>
            </form>

            <!-- Right section: User actions -->
            <div class="navbar-nav ms-lg-auto user-navbar align-items-lg-center">

                <% if (!currUser) { %>

                    <a class="nav-link" href="/talenttrack/login">
                        <b>Login</b>
                    </a>

                    <a
                        class="nav-link bg-primary text-white px-3 rounded register-link"
                        href="/talenttrack/register"
                    >
                        Register
                    </a>

                <% } else { %>

                    <span class="welcome-text">
                        Welcome <%= currUser.name %>
                    </span>

                    <% if (currUser.role === "student") { %>

                        <a href="/talenttrack/profile" class="btn btn-outline-primary">
                            View Profile
                        </a>

                    <% } else if (currUser.role === "recruiter") { %>

                        <a href="/talenttrack/recruiter/profile" class="btn btn-outline-primary">
                            View Profile
                        </a>

                    <% } %>

                    <a class="nav-link logout-link" href="/talenttrack/logout">
                        <b>Logout</b>
                    </a>

                <% } %>

            </div>

        </div>
    </div>
</nav>
