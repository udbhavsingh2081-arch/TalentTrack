<% layout("/layouts/boilerplate") %>

<style>
.hero-section{
    background: linear-gradient(135deg,#2170e4,#4f8ff7);
    color:white;
    border-radius:25px;
    padding:80px 30px;
    margin-top:20px;
    overflow:hidden;
}

.hero-section h1{
    animation: float 3s ease-in-out infinite;
}

@keyframes float{
    0%{transform:translateY(0px);}
    50%{transform:translateY(-10px);}
    100%{transform:translateY(0px);}
}

.feature-card{
    transition:all 0.3s ease;
    border:none;
    border-radius:20px;
}

.feature-card:hover{
    transform:translateY(-10px);
    box-shadow:0 15px 30px rgba(0,0,0,0.15);
}

.feature-icon{
    width:80px;
    height:80px;
    border-radius:50%;
    background:#2170e4;
    color:white;
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:2rem;
    margin:0 auto 20px;
}

.stats-box{
    background:#f8f9fa;
    border-radius:20px;
}

.stats-box h2{
    color:#2170e4;
    font-weight:bold;
}

.recruiter-section{
    background:#212529;
    color:white;
    border-radius:25px;
}

.fade-up{
    animation:fadeUp 1s ease;
}

@keyframes fadeUp{
    from{
        opacity:0;
        transform:translateY(30px);
    }
    to{
        opacity:1;
        transform:translateY(0);
    }
}
</style>

<div class="container">

    <!-- HERO -->
    <section class="hero-section text-center fade-up">

        <h1 class="display-3 fw-bold">
            TalentTrack
        </h1>

        <h3 class="mt-3">
            Find Internships, Jobs & Build Your Career
        </h3>

        <p class="lead mt-3">
            Connect with recruiters, discover opportunities,
            showcase your skills, and accelerate your career journey.
        </p>

        <div class="mt-4">

            <a href="/talenttrack/jobs"
               class="btn btn-light btn-lg me-3">
               Explore Jobs
            </a>

            <% if(!currUser){ %>
            <a href="/talenttrack/register"
               class="btn btn-outline-light btn-lg">
               Get Started
            </a>
            <% } %>

        </div>

        <!-- SEARCH BAR -->

        <form action="/talenttrack/jobs" class="mt-5">

            <div class="input-group input-group-lg w-75 mx-auto">

                <input
                    type="text"
                    class="form-control"
                    placeholder="Search jobs, internships, companies..."
                >

                <button class="btn btn-dark">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    Search
                </button>

            </div>

        </form>

    </section>

    <!-- FEATURES -->

    <section class="my-5 fade-up">

        <div class="text-center mb-5">
            <h2 class="fw-bold">Why TalentTrack?</h2>
            <p class="text-muted">
                Everything you need to start and grow your career.
            </p>
        </div>

        <div class="row">

            <div class="col-md-4 mb-4">

                <div class="card feature-card h-100 shadow-sm">

                    <div class="card-body text-center">

                        <div class="feature-icon">
                            <i class="fa-solid fa-briefcase"></i>
                        </div>

                        <h4>Find Jobs</h4>

                        <p>
                            Browse internships and full-time opportunities
                            from leading companies.
                        </p>

                    </div>

                </div>

            </div>

            <div class="col-md-4 mb-4">

                <div class="card feature-card h-100 shadow-sm">

                    <div class="card-body text-center">

                        <div class="feature-icon">
                            <i class="fa-solid fa-user-graduate"></i>
                        </div>

                        <h4>Build Your Profile</h4>

                        <p>
                            Showcase your projects, skills,
                            achievements and resume.
                        </p>

                    </div>

                </div>

            </div>

            <div class="col-md-4 mb-4">

                <div class="card feature-card h-100 shadow-sm">

                    <div class="card-body text-center">

                        <div class="feature-icon">
                            <i class="fa-solid fa-robot"></i>
                        </div>

                        <h4>AI Career Review</h4>

                        <p>
                            Receive AI-powered resume analysis
                            and career guidance.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </section>

    <!-- STATS -->

    <section class="stats-box py-5 my-5 fade-up">

        <div class="row text-center">

            <div class="col-md-4">

                <h2>500+</h2>
                <p>Students</p>

            </div>

            <div class="col-md-4">

                <h2>150+</h2>
                <p>Jobs Posted</p>

            </div>

            <div class="col-md-4">

                <h2>50+</h2>
                <p>Recruiters</p>

            </div>

        </div>

    </section>

    <!-- RECRUITER CTA -->

    <section class="recruiter-section p-5 text-center my-5 fade-up">

        <h2 class="fw-bold">
            Looking for Talent?
        </h2>

        <p class="mt-3">
            Post jobs, manage applications,
            and connect with qualified candidates.
        </p>

        <a href="/talenttrack/register"
           class="btn btn-light btn-lg mt-3">
           Join as Recruiter
        </a>

    </section>

    <!-- FINAL CTA -->

    <section class="text-center py-5 fade-up">

        <h2 class="fw-bold">
            Start Your Career Journey Today
        </h2>

        <p class="text-muted">
            Join TalentTrack and discover opportunities that match your skills.
        </p>

        <% if(!currUser){ %>

        <a href="/talenttrack/register"
           class="btn btn-primary btn-lg mt-3">
           Create Free Account
        </a>

        <% } %>

    </section>

</div>