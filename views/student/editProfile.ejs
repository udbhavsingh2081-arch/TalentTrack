<% layout("/layouts/boilerplate") %>

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-8">

            <div class="card shadow border-0">

                <div class="card-body p-4">

                    <h2 class="mb-4">
                        Edit Profile
                    </h2>
<form
    action="/talenttrack/student/profile?_method=PUT"
    method="POST"
    enctype="multipart/form-data" novalidate
>

                        <div class="mb-3">
                            <label class="form-label">
                                Full Name
                            </label>

                            <input
                                type="text"
                                name="name"
                                class="form-control"
                                value="<%= student.name %>"
                            >

                            
                 <div class="valid-feedback">looks good!</div>
               <div class="invalid-feedback">Please enter valid data</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Email
                            </label>

                            <input
                                type="email"
                                name="email"
                                class="form-control"
                                value="<%= student.email %>"
                            >
                            
                 <div class="valid-feedback">looks good!</div>
               <div class="invalid-feedback">Please enter valid Email</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                College
                            </label>

                            <input
                                type="text"
                                name="college"
                                class="form-control"
                                value="<%= student.college || '' %>"
                            >
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Degree
                            </label>

                            <input
                                type="text"
                                name="degree"
                                class="form-control"
                                value="<%= student.degree || '' %>"
                            >
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Graduation Year
                            </label>

                            <input
                                type="number"
                                name="graduationYear"
                                class="form-control"
                                value="<%= student.graduationYear || '' %>"
                            >

                            
                 <div class="valid-feedback">looks good!</div>
               <div class="invalid-feedback">Please enter valid data</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Skills
                            </label>

                            <textarea
                                name="skills"
                                class="form-control"
                                rows="3"
                            ><%= student.skills || '' %></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                GitHub Link
                            </label>

                            <input
                                type="text"
                                name="github"
                                class="form-control"
                                value="<%= student.github || '' %>"

                                
                 <div class="valid-feedback">looks good!</div>
               <div class="invalid-feedback">Please enter valid data</div>
                            >
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                LinkedIn Link
                            </label>

                            <input
                                type="text"
                                name="linkedin"
                                class="form-control"
                                value="<%= student.linkedin || '' %>"
                            >

                            
                 <div class="valid-feedback">looks good!</div>
               <div class="invalid-feedback">Please enter valid data</div>
                        </div>

                        <div class="mb-3">

                            <div class="mb-3">

    <label class="form-label">
        Profile Image
    </label>

    <% if(student.profileImage && student.profileImage.url){ %>

        <img
            src="<%= student.profileImage.url %>"
            width="120"
            height="120"
            class="rounded-circle d-block mb-2"
            style="object-fit:cover;"
        >

    <% } %>

    <input
        type="file"
        name="profileImage"
        class="form-control"
        accept="image/*"
    >

                 <div class="valid-feedback">looks good!</div>
               <div class="invalid-feedback">Please enter valid data</div>
</div>
                            

    <label class="form-label">
        Resume (PDF)
    </label>

    <% if(student.resume && student.resume.url){ %>

        <div class="mb-2">

            <a
                href="<%= student.resume.url %>"
                target="_blank"
                class="btn btn-success btn-sm"
            >
                <i class="fa-solid fa-file-pdf"></i>
                View Current Resume
            </a>

        </div>

    <% } %>

    <input
        type="file"
        name="resume"
        class="form-control"
        accept=".pdf"
    >

                 <div class="valid-feedback">looks good!</div>
               <div class="invalid-feedback">Please enter valid data</div>
    <small class="text-muted">
        Upload PDF resume only
    </small>

</div>

      <div class="mb-3">
                            <label class="form-label">
                                Resume Link
                            </label>

                            <input
                                type="text"
                                name="resumeLink"
                                class="form-control"
                                value="<%= student.resumeLink || '' %>"
                            >
                            
                 <div class="valid-feedback">looks good!</div>
               <div class="invalid-feedback">Please enter valid data</div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">
                                Bio
                            </label>

                            <textarea
                                name="bio"
                                class="form-control"
                                rows="4"
                            ><%= student.bio || '' %></textarea>
                            
                 <div class="valid-feedback">looks good!</div>
               <div class="invalid-feedback">Please enter valid data</div>
                        </div>

                        <button
                            class="btn btn-primary"
                        >
                            Save Profile
                        </button>

                        <a
                            href="/talenttrack/student/profile"
                            class="btn btn-secondary"
                        >
                            Cancel
                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>