<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Saved Jobs</h2>
            <p class="text-muted mb-0">
                Jobs you have bookmarked for later.
            </p>
        </div>
    </div>

    <% if (savedJobs.length === 0) { %>
        <div class="text-center py-5">
            <i class="bi bi-bookmark fs-1 text-muted"></i>
            <h4 class="mt-3">No saved jobs yet</h4>
            <p class="text-muted">
                Save interesting jobs and find them here later.
            </p>
            <a href="/talenttrack/jobs" class="btn btn-primary">
                Explore Jobs
            </a>
        </div>
    <% } else { %>

        <div class="row g-4">
            <% savedJobs.forEach(job => { %>
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body">
                            <h5 class="fw-bold">
                                <%= job.title %>
                            </h5>

                            <p class="text-muted mb-2">
                                <%= job.company %>
                            </p>

                            <p class="mb-2">
                                <i class="bi bi-geo-alt"></i>
                                <%= job.location %>
                            </p>

                            <% if (job.salary) { %>
                                <p class="mb-3">
                                    <strong>Salary:</strong>
                                    <%= job.salary %>
                                </p>
                            <% } %>

                            <a
                                href="/talenttrack/jobs/<%= job._id %>"
                                class="btn btn-primary btn-sm"
                            >
                                View Details
                            </a>

                            <form
                                action="/talenttrack/saved-jobs/<%= job._id %>/remove"
                                method="POST"
                                class="d-inline"
                            >
                                <button
                                    type="submit"
                                    class="btn btn-outline-danger btn-sm"
                                >
                                    <i class="bi bi-bookmark-x"></i>
                                    Remove
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>

    <% } %>
</div>