<% layout("/layouts/boilerplate") %>

<div class="container mt-4">

    <h1 class="mb-3">My Applications</h1>
    <p class="text-muted">
        Track and manage your job applications
    </p>

    
<!-- Profile Completeness Card -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-4">

        <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="mb-0">Profile Completeness</h5>

            <span class="fw-bold text-primary">
                <%= profileCompletion %>%
            </span>
        </div>

        <div
            class="progress mb-3"
            role="progressbar"
            aria-label="Profile completeness"
            aria-valuenow="<%= profileCompletion %>"
            aria-valuemin="0"
            aria-valuemax="100"
            style="height: 10px;"
        >
            <div
                class="progress-bar bg-success"
                style="width: <%= profileCompletion %>%"
            ></div>
        </div>

        <% if (profileCompletion === 100) { %>

            <p class="text-success mb-3">
                <i class="fa-solid fa-circle-check"></i>
                Great! Your profile is complete.
            </p>

        <% } else { %>

            <p class="text-muted mb-2">
                Complete your profile to help recruiters learn more about you.
            </p>

            <p class="fw-semibold mb-2">Still missing:</p>

            <ul class="mb-3">
                <% missingProfileFields.forEach(field => { %>
                    <li><%= field.label %></li>
                <% }) %>
            </ul>

        <% } %>

        <a href="/talenttrack/profile"
           class="btn btn-outline-primary btn-sm">
            <i class="fa-regular fa-user"></i>
            Update Profile
        </a>

    </div>
</div>

    <!-- Stats Cards -->
    <div class="row mb-4">

        <div class="col-md-3">
            <div class="card shadow-sm p-3">
                <h6>Total Applied</h6>
                <h2><%= totalApplied %></h2>
                <a href="/talenttrack/student/applications"
   class="btn btn-primary btn-sm">
   View Applications
</a>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm p-3 border-success">
                <h6>Selected</h6>
                <h2 class="text-success">
                    <%= selected %>
                </h2>
                        <a href="/talenttrack/student/applications?status=Selected"
   class="btn btn-success btn-sm">
   View Selected
</a>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm p-3 border-warning">
                <h6>Pending</h6>
                <h2 class="text-warning">
                    <%= pending %>
                </h2>
                    <a href="/talenttrack/student/applications?status=Pending"
   class="btn btn-warning btn-sm">
   View Pending
</a>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm p-3 border-danger">
                <h6>Rejected</h6>
                <h2 class="text-danger">
                    <%= rejected %>
                </h2>
                <a href="/talenttrack/student/applications?status=Rejected"
   class="btn btn-danger btn-sm">
   View Rejected
</a>
            </div>
        </div>

    </div>


    <!-- Applications -->
    <div class="row">

        <% applications.forEach(app => { %>

            <div class="col-md-4 mb-4">

                <div class="card shadow-sm h-100">

                    <div class="card-body">

                        <h4>
                            <%= app.job.title %>
                        </h4>

                        <h6 class="text-muted">
                            <%= app.job.company %>
                        </h6>

                        <hr>

                        <p>
                            <i class="fa-solid fa-location-dot"></i>
                            <%= app.job.location %>
                        </p>

                        <p>
                            <i class="fa-solid fa-indian-rupee-sign"></i>
                            ₹<%= app.job.salary %>
                        </p>

                        <p>
                            Applied:
                            <%= app.createdAt.toDateString() %>
                        </p>

                        <% if(app.status==="Pending"){ %>

                            <span class="badge bg-warning">
                                Pending
                            </span>

                        <% } %>

                        <% if(app.status==="Selected"){ %>

                            <span class="badge bg-success">
                                Selected
                            </span>

                        <% } %>

                        <% if(app.status==="Rejected"){ %>

                            <span class="badge bg-danger">
                                Rejected
                            </span>

                        <% } %>

                    </div>

                    <div class="card-footer bg-white">

                        <a
                            href="/talenttrack/jobs/<%= app.job._id %>"
                            class="btn btn-primary btn-sm"
                        >
                            View Job
                        </a>

                    </div>

                </div>

            </div>

        <% }) %>

    </div>

</div>