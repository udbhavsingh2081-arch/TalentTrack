<% layout("/layouts/boilerplate") %>

<div class="container mt-5">

    <div class="card shadow border-0">

        <div class="card-body p-5">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>
                    <h2>Student Profile</h2>
                    <% if(student.profileImage && student.profileImage.url){ %>

<img
    src="<%= student.profileImage.url %>"
    width="150"
    height="150"
    class="rounded-circle border"
    style="object-fit:cover;"
>

<% } else { %>

<div
    class="rounded-circle border d-flex justify-content-center align-items-center"
    style="width:150px;height:150px;"
>
    <i
        class="fa-solid fa-user"
        style="font-size:60px;color:gray;"
    ></i>
</div>

<% } %>
                </div>

                <a
                    href="/talenttrack/student/profile/edit"
                    class="btn btn-primary"
                >
                    Edit Profile
                </a>

                <a
                    href="/talenttrack/student/ai-review"
                    class="btn btn-primary"
                                                    >
                                AI Resume Review
                    </a>
            </div>

            <hr>

            <div class="row">

                <div class="col-md-6 mb-4">
                    <label class="form-label fw-bold">
                        Full Name
                    </label>

                    <input
                        type="text"
                        class="form-control"
                        value="<%= student.name %>"
                        readonly
                    >
                </div>

                <div class="col-md-6 mb-4">
                    <label class="form-label fw-bold">
                        Email
                    </label>

                    <input
                        type="text"
                        class="form-control"
                        value="<%= student.email %>"
                        readonly
                    >
                </div>

                <div class="col-md-6 mb-4">
                    <label class="form-label fw-bold">
                        College
                    </label>

                    <input
                        type="text"
                        class="form-control"
                        value="<%= student.college || '' %>"
                        readonly
                    >
                </div>

                <div class="col-md-6 mb-4">
                    <label class="form-label fw-bold">
                        Degree
                    </label>

                    <input
                        type="text"
                        class="form-control"
                        value="<%= student.degree || '' %>"
                        readonly
                    >
                </div>

                <div class="col-md-6 mb-4">
                    <label class="form-label fw-bold">
                        Graduation Year
                    </label>

                    <input
                        type="text"
                        class="form-control"
                        value="<%= student.graduationYear || '' %>"
                        readonly
                    >
                </div>

                <div class="col-md-6 mb-4">
                    <label class="form-label fw-bold">
                        Skills
                    </label>

                    <input
                        type="text"
                        class="form-control"
                        value="<%= student.skills || '' %>"
                        readonly
                    >
                </div>

                <div class="col-md-6 mb-4">
                    <label class="form-label fw-bold">
                        GitHub
                    </label>

                    <% if(student.github){ %>
                        <a
                            href="<%= student.github %>"
                            target="_blank"
                            class="btn btn-outline-dark w-100"
                        >
                            Open GitHub
                        </a>
                    <% } else { %>
                        <input
                            type="text"
                            class="form-control"
                            value="Not Added"
                            readonly
                        >
                    <% } %>
                </div>

                <div class="col-md-6 mb-4">
                    <label class="form-label fw-bold">
                        LinkedIn
                    </label>

                    <% if(student.linkedin){ %>
                        <a
                            href="<%= student.linkedin %>"
                            target="_blank"
                            class="btn btn-outline-primary w-100"
                        >
                            Open LinkedIn
                        </a>
                    <% } else { %>
                        <input
                            type="text"
                            class="form-control"
                            value="Not Added"
                            readonly
                        >
                    <% } %>
                </div>

                <div class="col-md-12 mb-4">

                    <label class="form-label fw-bold">
                        Resume
                    </label>

    <% if(student.resume && student.resume.url){ %>

<a href="<%= student.resume.url %>">
    View Resume
</a>

<% }else { %>

<p>No Resume</p>

<% } %>

                </div>

                <div class="col-md-12">

                    <label class="form-label fw-bold">
                        Bio
                    </label>

                    <textarea
                        class="form-control"
                        rows="5"
                        readonly
                    ><%= student.bio || '' %></textarea>

                </div>

            </div>

        </div>

    </div>

</div>