<% layout("/layouts/boilerplate") %>

<h2 class="mb-4">Manage Jobs</h2>
<table class="table">
    <thead>
        <tr>
            <th>Job Title</th>
            <th>Company</th>
            <th>Location</th>
            <th>Salary</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        <% jobs.forEach(job => { %>

            <tr>

                <td><%= job.title %></td>

                <td><%= job.company %></td>

                <td><%= job.location %></td>

                <td>₹<%= job.salary %></td>

                <td>

                    <a
                        href="/talenttrack/jobs/<%= job._id %>"
                        class="btn btn-primary btn-sm"
                    >
                        View
                    </a>

                    <a
                        href="/talenttrack/jobs/edit/<%= job._id %>"
                        class="btn btn-warning btn-sm"
                    >
                        Edit
                    </a>

                    <form
                        action="/talenttrack/jobs/<%= job._id %>?_method=DELETE"
                        method="POST"
                        style="display:inline"
                    >
                        <button
                            class="btn btn-danger btn-sm"
                        >
                            Delete
                        </button>
                    </form>

                </td>

            </tr>

        <% }) %>

    </tbody>
</table>