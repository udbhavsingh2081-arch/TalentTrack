<% layout("/layouts/boilerplate") %>

<div class="container mt-5">

    <div class="card shadow border-0">

        <div class="card-body p-5">

            <!-- Company Logo -->

            <div class="text-center mb-4">

                <% if(recruiter.companyLogo && recruiter.companyLogo.url){ %>

                    <img
                        src="<%= recruiter.companyLogo.url %>"
                        class="rounded-circle border shadow"
                        width="140"
                        height="140"
                        style="object-fit: cover;"
                    >

                <% } else { %>

                    <div
                        class="rounded-circle border d-inline-flex justify-content-center align-items-center"
                        style="width:140px;height:140px;"
                    >
                        <i
                            class="fa-solid fa-building"
                            style="font-size:60px;color:gray;"
                        ></i>
                    </div>

                <% } %>
                

            </div>

            <!-- Header -->

            <div class="text-center">

                <h2 class="fw-bold">
                    <%= recruiter.companyName || recruiter.name %>
                </h2>

                <p class="text-muted fs-5">
                    <%= recruiter.designation || "Recruiter" %>
                </p>

            </div>

            <hr class="my-4">

            <!-- Details -->

            <div class="row">

                <div class="col-md-6 mb-4">

                    <h6 class="text-muted">
                        Recruiter Name
                    </h6>

                    <p class="fs-5">
                        <%= recruiter.name %>
                    </p>

                </div>

                <div class="col-md-6 mb-4">

                    <h6 class="text-muted">
                        Email
                    </h6>

                    <p class="fs-5">
                        <%= recruiter.email %>
                    </p>

                </div>

                <div class="col-md-6 mb-4">

                    <h6 class="text-muted">
                        Company Name
                    </h6>

                    <p class="fs-5">
                        <%= recruiter.companyName || "Not Added" %>
                    </p>

                </div>

                <div class="col-md-6 mb-4">

                    <h6 class="text-muted">
                        Designation
                    </h6>

                    <p class="fs-5">
                        <%= recruiter.designation || "Not Added" %>
                    </p>
                    
                    <p class="text-success fw-bold">
    Active Jobs Posted: <%= totalJobs %>
</p>
                </div>

                <div class="col-md-6 mb-4">

                    <h6 class="text-muted">
                        Company Website
                    </h6>

                    <% if(recruiter.companyWebsite){ %>

                        <a
                            href="<%= recruiter.companyWebsite %>"
                            target="_blank"
                            class="btn btn-outline-primary btn-sm"
                        >
                            Visit Website
                        </a>

                    <% } else { %>

                        <p>Not Added</p>

                    <% } %>

                </div>

                <div class="col-md-6 mb-4">

                    <h6 class="text-muted">
                        Company Location
                    </h6>

                    <p class="fs-5">
                        <%= recruiter.companyLocation || "Not Added" %>
                    </p>

                </div>

            </div>

            <hr>

            <!-- About Company -->

            <div class="mt-4">

                <h4 class="fw-bold">
                    About Company
                </h4>

                <p class="mt-3">
                    <%= recruiter.aboutCompany || "No company description available." %>
                </p>

            </div>

            <!-- Back Button -->

            <div class="mt-4">

                <a
                    href="/talenttrack/jobs"
                    class="btn btn-secondary"
                >
                    Back to Jobs
                </a>

         <% if(currUser?.role === "recruiter"){ %>

<a
    href="/talenttrack/recruiter/profile/edit"
    class="btn btn-primary"
>
    Edit Profile
</a>

<% } %>

            </div>

        </div>

    </div>

</div>